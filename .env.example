# IntelliGrade Classifier Configuration

# Local/LAN Ollama Endpoint (e.g. Dell server: http://192.168.1.50:11434/api/generate)
OLLAMA_SERVER_URL=http://localhost:11434/api/generate

# Model Name hosted on Ollama instance
MODEL_NAME=llama3:8b

# Offline / Mock Fallback toggle (true = use built-in heuristic classifier, false = use Ollama server)
MOCK_MODE=false

# Auto-fallback to mock mode if Ollama server is unreachable
AUTO_MOCK_FALLBACK=true

# Network Request Timeout in seconds
REQUEST_TIMEOUT=30

# Maximum retries on network failure or rate limits
MAX_RETRIES=3

# Exponential backoff base factor (seconds)
BACKOFF_FACTOR=1.5

# Inference parameters
NUM_PREDICT=150
TEMPERATURE=0.1
